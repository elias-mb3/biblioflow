PORT=3000
NODE_ENV=development
DATABASE_URL=file:./data/biblioflow.db

# Segredo para assinar os JWT. OBRIGATÓRIO em produção: a aplicação NÃO sobe
# (NODE_ENV=production) se este valor estiver ausente ou for um exemplo inseguro.
# Gere um aleatório forte, ex.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=1d

MAX_RENTALS_PER_USER=3

# Origem permitida pelo CORS (URL do frontend).
CORS_ORIGIN=http://localhost:4200

# Permite cadastrar o 1º gestor publicamente (bootstrap). Após existir um gestor,
# novos gestores só podem ser criados por um gestor autenticado. Defina como
# false para exigir que o gestor inicial venha do seed.
ALLOW_PUBLIC_MANAGER_BOOTSTRAP=true

# Rate limiting das rotas /auth (proteção contra força bruta).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
