PORT=3000
NODE_ENV=development
DATABASE_URL=file:./data/biblioflow.db

# Segredo para assinar os JWT. OBRIGATÓRIO em produção: a aplicação NÃO sobe
# (NODE_ENV=production) se este valor estiver ausente ou for um exemplo inseguro.
# Gere um aleatório forte, ex.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=1d

MAX_RENTALS_PER_USER=3

# Origem permitida pelo CORS (URL do frontend).
CORS_ORIGIN=http://localhost:4200

# Permite cadastrar o 1º gestor publicamente (bootstrap). Após existir um gestor,
# novos gestores só podem ser criados por um gestor autenticado. Defina como
# false para exigir que o gestor inicial venha do seed.
ALLOW_PUBLIC_MANAGER_BOOTSTRAP=true

# Rate limiting das rotas /auth (proteção contra força bruta).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ── Cadastro de livros por ISBN ─────────────────────────────────────────────
# A consulta percorre, nesta ordem: Open Library (capa e sinopse), BrasilAPI/CBL
# (catálogo de edições brasileiras) e Google Books. NENHUMA destas variáveis é
# obrigatória — os dois primeiros provedores não exigem chave, então a feature
# funciona sem configuração alguma. A API precisa ter acesso de saída à internet;
# sem rede, o cadastro manual continua funcionando.

# Desligue para desabilitar as rotas de consulta (elas passam a responder 503).
ISBN_LOOKUP_ENABLED=true

# Timeout de cada requisição ao provedor externo.
ISBN_LOOKUP_TIMEOUT_MS=5000

# Cache em memória dos metadados: 24h para acerto, 1h para "não encontrado".
ISBN_CACHE_TTL_MS=86400000
ISBN_NOT_FOUND_CACHE_TTL_MS=3600000

# Rate limit das rotas de consulta por ISBN (mesma janela do AUTH_RATE_LIMIT_WINDOW_MS).
ISBN_LOOKUP_RATE_LIMIT_MAX=30

# OPCIONAL. Terceiro provedor, usado só quando Open Library e BrasilAPI falham.
# Requisições anônimas ao Google Books são recusadas com 429, então sem chave o
# fallback fica desligado — e os outros dois provedores dão conta.
GOOGLE_BOOKS_API_KEY=
